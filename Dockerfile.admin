# Build stage
FROM golang:1.24.1-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o /out/admin ./cmd/admin \
 && go build -o /out/migrate ./cmd/migrate \
 && go build -o /out/seed ./cmd/seed

# Run stage. The image also carries migrate and seed so the same image can run
# migrations before the service starts and create users when registration is off.
FROM alpine:latest
WORKDIR /app

COPY --from=builder /out/ ./

EXPOSE 8086

CMD ["./admin"]
