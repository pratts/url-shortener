ENV=development
REDIRECT_PORT=8085
ADMIN_PORT=8086
API_URL=http://localhost:8085

# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=urlshortener
DB_SCHEMA=public
# disable | require | verify-full. Defaults to require when ENV=production, disable otherwise.
DB_SSLMODE=disable

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0
REDIS_TTL=3600

# JWT configuration
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_EXPIRY_TIME_HOURS=1

# CORS configuration
CORS_ORIGINS="http://localhost:3000"

# Swagger UI. Defaults to enabled outside production and disabled in production.
ENABLE_SWAGGER=true

# Reverse proxy. Set both when running behind a proxy/load balancer so the real
# client IP is used for rate limiting and click analytics.
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=10.0.0.0/8
