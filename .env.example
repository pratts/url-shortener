# Copy to .env for local development. Outside production (ENV != production)
# the services read .env if it exists; real environment variables win.
ENV=development

# Public base URL of the redirect service. Short links are built from it, and
# links pointing back at its host are refused.
SHORT_URL_BASE=http://localhost:8085

ADMIN_PORT=8086
REDIRECT_PORT=8085

# Postgres. docker-compose overrides DB_HOST to reach its own container.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=urlshortener
# disable | allow | prefer | require | verify-ca | verify-full.
# Defaults to require when ENV=production, disable otherwise.
DB_SSLMODE=disable

# Redis. docker-compose overrides REDIS_HOST and requires REDIS_PASSWORD.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0
# Seconds a resolved short link stays cached.
REDIS_TTL=3600

# Admin API only. At least 32 bytes; generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_EXPIRY_TIME_HOURS=1

# Admin API only. Required: comma-separated origins allowed to call the API
# from a browser. "*" is rejected because credentials are allowed.
CORS_ORIGINS=http://localhost:3000

# Admin API only. POST /api/v1/users/register (limited to 5 per IP per hour).
REGISTRATION_ENABLED=true

# Admin API only. Swagger UI; defaults to on outside production, off in production.
ENABLE_SWAGGER=true

# Reverse proxy. Set both when running behind a proxy or load balancer so the
# real client IP is used for rate limiting and click analytics.
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=10.0.0.0/8
